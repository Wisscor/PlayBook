# Copy this file to .env and edit if your backend is somewhere else.
#
#   cp .env.example .env
#
# This is read by vite.config.js at startup (not by the browser), and is the
# single place the backend URL is configured. Restart `npm run dev` after a change.
#
# back/docker-compose.yaml publishes the api service on host port 8000.
BACKEND_URL=http://127.0.0.1:8000
