FROM python:3.14-slim

# Install uv from official Astral image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /back-end

# UV will compile Python source files to bytecode after installation.
ENV UV_COMPILE_BYTECODE=1
# copy packages instead of linking them
ENV UV_LINK_MODE=copy

COPY pyproject.toml uv.lock ./

# Install production dependencies only (no dev, frozen lockfile)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Place virtual environment executables at front of PATH
ENV PATH="/back-end/.venv/bin:$PATH"

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]