# ── App ──────────────────────────────────────────────
APP_NAME=PlayBook
DEBUG=false

# ── Database ─────────────────────────────────────────
# Used by docker-compose / the postgres container
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
POSTGRES_HOST=localhost   # use the service name (e.g. "postgres") inside docker
POSTGRES_PORT=5432

# Format: dialect+driver://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/your_db_name


# ── Session cookie ───────────────────────────────────
SESSION_COOKIE_NAME=session_id
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false      # true in production (HTTPS)
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax     # lax | strict | none

# ── CORS ─────────────────────────────────────────────
# Must be a JSON list
CORS_ORIGINS=["http://localhost:3000"]