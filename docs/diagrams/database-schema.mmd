erDiagram
    users {
        UUID id PK
        VARCHAR firstname
        VARCHAR lastname
        VARCHAR username UK
        VARCHAR email UK
        VARCHAR avatar
        TEXT bio
        VARCHAR hashed_password
        TIMESTAMPTZ created_at
    }

    sessions {
        UUID id PK
        UUID user_id FK
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ created_at
    }

    posts {
        UUID id PK
        UUID user_id FK
        TEXT caption
        TIMESTAMPTZ created_at
        TIMESTAMPTZ updated_at
    }

    followers {
        UUID follower_id PK, FK
        UUID following_id PK, FK
        TIMESTAMPTZ created_at
    }

    sports {
        UUID id PK
        VARCHAR name UK
        INTEGER max_players
    }

    user_sports {
        UUID user_id PK, FK
        UUID sport_id PK, FK
    }

    match_announcements {
        UUID id PK
        UUID organizer_id FK
        UUID sport_id FK
        VARCHAR title
        INTEGER remaining_player_slots
        ENUM match_status
        TIMESTAMPTZ start_time
        TIMESTAMPTZ end_time
        TIMESTAMPTZ created_at
    }

    play_requests {
        UUID id PK
        UUID announcement_id FK
        UUID sender_id FK
        ENUM status
        TIMESTAMPTZ created_at
    }

    conversations {
        UUID id PK
        TIMESTAMPTZ created_at
    }

    conversation_participants {
        UUID id PK
        UUID conversation_id FK
        UUID user_id FK
        UUID last_read_message_id
    }

    messages {
        UUID id PK
        UUID conversation_id FK
        UUID sender_id FK
        TEXT body
        TIMESTAMPTZ created_at
    }

    pending_messages {
        UUID id PK
        UUID user_id FK
        UUID message_id FK
        TIMESTAMPTZ delivered_at
        TIMESTAMPTZ created_at
    }

    notifications {
        UUID id PK
        UUID user_id FK
        UUID actor_id FK
        VARCHAR event_type
        UUID target_id
        TIMESTAMPTZ match_time
        TIMESTAMPTZ read_at
        TIMESTAMPTZ delivered_at
        TIMESTAMPTZ created_at
    }

    users ||--o{ sessions : owns
    users ||--o{ posts : writes
    users ||--o{ followers : follower_id
    users ||--o{ followers : following_id
    users ||--o{ user_sports : selects
    sports ||--o{ user_sports : selected_by
    users ||--o{ match_announcements : organizes
    sports ||--o{ match_announcements : categorizes
    match_announcements ||--o{ play_requests : receives
    users ||--o{ play_requests : sends
    conversations ||--o{ conversation_participants : includes
    users ||--o{ conversation_participants : joins
    conversations ||--o{ messages : contains
    users ||--o{ messages : sends
    messages ||--o{ pending_messages : queues
    users ||--o{ pending_messages : receives
    users ||--o{ notifications : receives
    users ||--o{ notifications : triggers