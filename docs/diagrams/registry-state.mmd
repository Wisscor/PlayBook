flowchart TD
    subgraph before ["_connections after 2 users × 2 tabs connect"]
        direction LR
        subgraph userA ["User A (UUID-A)"]
            wsA1["WebSocket A-Tab1"]
            wsA2["WebSocket A-Tab2"]
        end
        subgraph userB ["User B (UUID-B)"]
            wsB1["WebSocket B-Tab1"]
            wsB2["WebSocket B-Tab2"]
        end
    end

    subgraph state_before ["_connections: dict&lt;UUID, set&lt;WebSocket&gt;&gt;"]
        sA["UUID-A → {ws_A1, ws_A2}"]
        sB["UUID-B → {ws_B1, ws_B2}"]
    end

    subgraph helpers_before ["Helper results"]
        h1["connections_for(UUID-A) → {ws_A1, ws_A2}"]
        h2["connections_for(UUID-B) → {ws_B1, ws_B2}"]
        h3["online_user_ids() → {UUID-A, UUID-B}"]
        h4["send_to_user(UUID-A, frame) → sends to ws_A1 and ws_A2"]
    end

    before --> state_before
    state_before --> helpers_before

    subgraph event ["Event: User A Tab1 disconnects"]
        e1["on_disconnect calls:<br/>registry.unregister(UUID-A, ws_A1)"]
        e2["_connections[UUID-A].discard(ws_A1)"]
        e3["set is NOT empty → key stays"]
        e4["connections_for(UUID-A) → still returns sockets"]
        e5["∴ announce_presence(online=False) is NOT sent"]
    end

    helpers_before --> event

    subgraph state_after ["_connections after Tab1 closes"]
        sa["UUID-A → {ws_A2}"]
        sb["UUID-B → {ws_B1, ws_B2}"]
    end

    subgraph helpers_after ["Helper results after"]
        ha1["connections_for(UUID-A) → {ws_A2}"]
        ha2["online_user_ids() → {UUID-A, UUID-B}"]
        ha3["User A still appears online"]
    end

    event --> state_after
    state_after --> helpers_after

    subgraph last_tab ["If User A Tab2 also disconnects"]
        l1["unregister(UUID-A, ws_A2)"]
        l2["set is empty → del _connections[UUID-A]"]
        l3["connections_for(UUID-A) → empty set"]
        l4["announce_presence(contacts, UUID-A, False)"]
        l5["online_user_ids() → {UUID-B}"]
    end

    helpers_after --> last_tab
