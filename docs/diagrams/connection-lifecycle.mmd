sequenceDiagram
    participant Browser
    participant ws as websocket_endpoint (ws.py)
    participant auth as authenticate_socket (ws_auth.py)
    participant reg as registry (registry.py)
    participant conn as on_connect (connection.py)
    participant recv as receive_loop (ws.py)
    participant wd as _idle_watchdog (ws.py)
    participant disc as on_disconnect (connection.py)

    Browser->>ws: WebSocket /ws
    ws->>ws: websocket.accept()
    ws->>ws: last_seen = time.monotonic()

    rect rgb(230, 245, 255)
        Note over ws,auth: DB session opens (session_maker)
        ws->>auth: authenticate_socket(websocket, db)
        auth->>auth: Read cookie (settings.session_cookie_name)
        alt No cookie / invalid UUID
            auth->>Browser: close(4001 CLOSE_AUTH_FAILED)
            auth-->>ws: return None
        else Session not found / expired
            auth->>Browser: close(4001 CLOSE_AUTH_FAILED)
            auth-->>ws: return None
        else User not found
            auth->>Browser: close(4001 CLOSE_AUTH_FAILED)
            auth-->>ws: return None
        else Valid session
            auth-->>ws: return User
        end
        Note over ws,auth: DB session closes
    end

    ws->>ws: Create ConnectionContext(sends=SlidingWindow(10), strikes=SlidingWindow(60))
    ws->>reg: connections_for(user.id) → check if first_socket
    ws->>reg: register(user.id, websocket)

    rect rgb(232, 255, 232)
        Note over ws,Browser: Frame order sent on connect
        ws->>Browser: ① ready {type: "ready", user_id, username}
        ws->>conn: on_connect(websocket, user, first_socket)

        conn->>conn: _flush_pending_messages (session_maker)
        Note over conn: DB: take_pending_messages → mark_pending_delivered
        conn->>Browser: ② pending message.new frames (one per message)

        conn->>conn: _flush_notifications (session_maker)
        Note over conn: DB: get_undelivered_notifications → mark_delivered
        conn->>Browser: ③ notification frames (one per notification)
        conn->>conn: get_unread_count(db, user_id)
        conn->>Browser: ④ notification.count {unread_count}

        conn->>conn: _send_presence_snapshot (session_maker)
        Note over conn: DB: get_contact_ids
        conn->>Browser: ⑤ presence.snapshot {online: [...]}

        alt first_socket is True
            conn->>conn: announce_presence(contacts, user.id, True)
            conn->>reg: send_to_user(contact_id, presence frame) for each contact
            Note over reg: ⑥ presence {online: true} to contacts
        end
        conn-->>ws: return contacts
    end

    par receive_loop task
        loop Forever
            Browser->>recv: frame (JSON)
            recv->>recv: last_seen = time.monotonic()
            recv->>recv: Look up HANDLERS[frame.type]
            recv->>recv: Call handler or reject
        end
    and _idle_watchdog task
        loop Every 15s sleep
            wd->>wd: Check time.monotonic() - last_seen > 45
            alt Idle > 45s
                wd->>Browser: close(4004 CLOSE_IDLE_TIMEOUT)
            end
        end
    end

    Note over ws: asyncio.wait FIRST_COMPLETED → cancel other

    ws->>disc: on_disconnect(user, websocket, contacts)
    disc->>reg: unregister(user.id, websocket)
    alt No remaining sockets for user
        disc->>disc: announce_presence(contacts, user.id, False)
        disc->>reg: send_to_user → presence {online: false}
    end
