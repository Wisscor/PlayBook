flowchart LR
    subgraph realtime ["back/app/realtime/"]
        ws["ws.py<br/>(WebSocket endpoint)"]
        auth["ws_auth.py<br/>(authenticate_socket)"]
        conn["connection.py<br/>(on_connect, on_disconnect)"]
        handlers["handlers.py<br/>(HANDLERS map)"]
        svc["service.py<br/>(business logic)"]
        dlv["delivery.py<br/>(deliver_message)<br/>⚠️ NO database access"]
        reg["registry.py<br/>(_connections dict)"]
        frm["frames.py<br/>(frame type constants)"]
        lim["limits.py<br/>(SlidingWindow)"]
        sch["schemas.py<br/>(Pydantic models)"]
        mdl["models.py<br/>(SQLAlchemy ORM)"]
        rest["rest.py<br/>(REST API routes)"]
        notify["notify.py<br/>(emit_notification)"]
    end

    subgraph external ["External dependencies"]
        db["database.session_maker<br/>database.get_db"]
        user_model["models.user.User"]
        session_model["models.session.Session"]
        config["core.config.settings"]
        deps["core.deps.get_curr_user"]
        follower_model["models.Follower"]
    end

    %% ws.py imports
    ws --> conn
    ws --> frm
    ws --> reg
    ws --> handlers
    ws --> lim
    ws --> auth
    ws --> db

    %% ws_auth.py imports
    auth --> frm
    auth --> config
    auth --> session_model
    auth --> user_model

    %% connection.py imports
    conn --> frm
    conn --> reg
    conn --> svc
    conn --> db

    %% handlers.py imports
    handlers --> dlv
    handlers --> frm
    handlers --> reg
    handlers --> svc
    handlers --> lim
    handlers --> sch
    handlers --> db
    handlers --> user_model

    %% service.py imports
    svc --> frm
    svc --> mdl
    svc --> follower_model
    svc --> user_model

    %% delivery.py imports (NO DB!)
    dlv --> reg
    dlv --> svc

    %% rest.py imports
    rest --> svc
    rest --> sch
    rest --> mdl
    rest --> db
    rest --> user_model
    rest --> deps

    %% notify.py imports
    notify --> reg
    notify --> svc
    notify --> db
    notify --> user_model

