# Database credentials
POSTGRES_USER=playbook_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=playbook_db

# The API uses the Compose service name for PostgreSQL
DATABASE_URL=postgresql+asyncpg://playbook_user:change-me@postgres:5432/playbook_db

# Application settings
APP_NAME=PlayBook
DEBUG=false
LOG_LEVEL=INFO
SESSION_COOKIE_NAME=session_id
SESSION_EXPIRE_DAYS=7
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
CORS_ORIGINS=["http://localhost:3000"]

# Host ports and browser-facing API URL
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
